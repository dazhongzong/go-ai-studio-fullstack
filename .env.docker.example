# Copy this file to .env before running `make docker-up`.
# The Dynamo frontend and SGLang worker continue to run on the GPU host.
BACKEND=dynamo
DOCKER_DYNAMO_URL=http://host.docker.internal:8000
DYNAMO_MODEL=Qwen/Qwen3-0.6B

# Leave empty for a local demo. If set, pass the same value as VITE_API_KEY
# during the image build; the browser must send this key to the gateway.
API_KEY=

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=go_ai_studio
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

MAX_IN_FLIGHT=8
POOL_WORKERS=3
POOL_QUEUE_SIZE=5
TASK_TIMEOUT=90s
ASK_TIMEOUT=100s
STREAM_TIMEOUT=180s
MAX_PROMPT_LENGTH=8192
MAX_CONTEXT_MESSAGES=24
MAX_CONTEXT_LENGTH=32768
