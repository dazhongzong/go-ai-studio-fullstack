BACKEND=dynamo
DYNAMO_URL=http://127.0.0.1:8000
DYNAMO_MODEL=Qwen/Qwen3-0.6B

QUEUE_URL=amqp://guest:guest@127.0.0.1:5672/
# Set this separately for every inference-worker process, for example
# WORKER_ID=worker-1
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/go_ai_studio?parseTime=true

PORT=18080
LOG_DIR=logs
GIN_MODE=release
API_KEY=
MAX_IN_FLIGHT=8
POOL_WORKERS=3
POOL_QUEUE_SIZE=5
TASK_TIMEOUT=90s
ASK_TIMEOUT=100s
STREAM_TIMEOUT=180s

MAX_PROMPT_LENGTH=8192
MAX_CONTEXT_MESSAGES=24
MAX_CONTEXT_LENGTH=32768
